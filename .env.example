# OpenRouter API Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: App Attribution for OpenRouter
# OPENROUTER_APP_URL=https://your-app.com
# OPENROUTER_APP_TITLE=Meta Agent MCP

# Model Configuration
# Default model: x-ai/grok-4-fast (via OpenRouter)
META_AGENT_MODEL=x-ai/grok-4-fast

# Server Configuration
META_AGENT_HOST=localhost
META_AGENT_PORT=8000

# Logging
LOG_LEVEL=INFO

